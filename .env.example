# ============================================
# RutaQuilla - Variables de Entorno (PLANTILLA)
# ============================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env real a Git.
#
#   cp .env.example .env
#
# ============================================

# Puerto del servidor Express
PORT=5000

# MongoDB Atlas
# Crear cluster gratis en: https://cloud.mongodb.com
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/rutaquilla?retryWrites=true&w=majority&appName=RutaQuilla

# Secreto para firmar tokens JWT
# Generar uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=7d

# Entorno de ejecución (development | production)
NODE_ENV=development

# Google Maps API Key (opcional — necesaria para geocoding preciso y Snap to Roads)
# Obtener en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Zoho Mail SMTP (para verificación de email al registrarse)
# Crear cuenta en Zoho Mail → Configurar contraseña de app
ZOHO_EMAIL=
ZOHO_PASSWORD=
