{
  "appId": "me.rutaquilla.app",
  "appName": "RutaQuilla",
  "webDir": "dist",
  "server": {
    "hostname": "app.rutaquilla.me",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0D1014",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0D1014",
      "overlaysWebView": false
    }
  }
}
